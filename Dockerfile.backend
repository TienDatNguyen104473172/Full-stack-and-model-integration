# Dockerfile cho Backend - đặt ở root để dễ deploy trên Render
# 1. Sử dụng Python phiên bản đã fix (Tương thích với Numpy 2.3.3)
FROM python:3.11-slim 

# 2. Thiết lập thư mục làm việc
WORKDIR /app

# 3. COPY file requirements.txt (từ thư mục backend/ vào /app)
COPY backend/requirements.txt .

# 4. Cài đặt các thư viện
RUN pip install --no-cache-dir -r requirements.txt

# 5. COPY thư mục models vào đúng vị trí code Python mong đợi
COPY models /models 

# 6. Copy toàn bộ code backend vào thư mục gốc của /app
COPY backend /app 

# 7. Mở cổng và chạy server
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

